# AI-Powered GitHub Project Mentor: Environment Variables

PORT=8000
DATABASE_URL=sqlite:///./project_mentor.db

# Optional: NVIDIA NIM API key (Free credits at https://build.nvidia.com)
# Ultra-low latency models: meta/llama-3.1-8b-instruct or meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional: Google Gemini API key for dynamic LLM reasoning
GEMINI_API_KEY=

# Optional: GitHub Personal Access Token for higher rate limits or private repos
GITHUB_TOKEN=

# Optional: Supabase PostgreSQL URL (if deploying to Supabase)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
